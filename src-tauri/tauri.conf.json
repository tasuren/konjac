{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konjac",
  "version": "0.1.0",
  "identifier": "jp.tasuren.konjac",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Konjac",
        "width": 900,
        "height": 650,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 12, "y": 24 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/common/32x32.png",
      "icons/common/128x128.png",
      "icons/common/128x128@2x.png",
      "icons/common/icon.icns",
      "icons/common/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
